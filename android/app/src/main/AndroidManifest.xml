<?xml version="1.0" encoding="utf-8"?>
<!--
  GizeCat for Android tablets (android/README.md). Every permission below serves the floating cat
  (1.4.1) and nothing else; the app is fully usable without any of them being granted:
  - SYSTEM_ALERT_WINDOW ("Display over other apps"): draws the cat in a small transparent window
    above other apps. A special permission: it is never granted by the install; the user turns it on
    in Android's own settings page, which the app opens only when asked to
    (docs/platforms/android-overlay.md, "Permissions").
  - FOREGROUND_SERVICE and FOREGROUND_SERVICE_SPECIAL_USE: the service that keeps the cat alive while
    other apps are in front (Android 14 needs a declared type; the type and its subtype are below).
  - POST_NOTIFICATIONS (Android 13+): shows the service's notification with its Pause, Hide and Stop
    buttons. Asked once, and only when the floating cat is first started; declining changes nothing
    else (the same buttons are on the app screen).
  Still absent: INTERNET (the OS itself forbids network access), storage permissions (the Storage
  Access Framework needs none), RECEIVE_BOOT_COMPLETED (the cat never starts by itself),
  accessibility, and screen capture or reading.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- androidx.core declares this for ContextCompat.registerReceiver, which the app never calls. -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.GizeCat"
        android:usesCleartextTraffic="false"
        tools:targetApi="36">

        <!-- No WebView usage metrics (no telemetry). -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />

        <!--
          configChanges: rotation, split screen, free-form resizing, display size, keyboards and moves
          to another display do not recreate the Activity, so the WebView and the cat stay live and the
          page just gets a resize. Deliberately not listed: uiMode (night mode, docks), locale,
          layoutDirection and fontScale. Those recreate the Activity so the theme, system bars and
          text are applied from scratch; the cat is saved in onPause and reloaded from localStorage.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|touchscreen|colorMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The floating cat's foreground service (FloatingCatService.kt). Not exported: only the app's
          own screen and its own notification buttons (explicit intents) can reach it. specialUse,
          because no predefined type fits "keeps a transparent pet window over other apps alive";
          the subtype below is what Google Play's foreground-service declaration asks for.
        -->
        <service
            android:name=".FloatingCatService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's floating desktop-pet cat window displayed over other apps while it is running. Started and stopped only by the user." />
        </service>
    </application>
</manifest>
