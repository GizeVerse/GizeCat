{
  "name": "desktop-cat",
  "productName": "Desktop Cat",
  "version": "1.0.0",
  "description": "A living desktop companion: one animated, persistent cat that lives on your Windows desktop.",
  "author": "enesiltas",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "start": "electron .",
    "dev": "node scripts/build.mjs --dev && electron . --dev",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "node scripts/build.mjs && playwright test",
    "icons": "electron scripts/gen-icons.cjs",
    "package": "node scripts/build.mjs && electron-builder --win nsis --publish never",
    "package:dir": "node scripts/build.mjs && electron-builder --win dir --publish never",
    "check": "npm run typecheck && npm run lint && npm test",
    "verify": "node scripts/with-lock.mjs verify -- npm run check"
  },
  "dependencies": {
    "koffi": "3.3.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "electron": "44.9.3",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
