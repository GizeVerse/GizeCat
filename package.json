{
  "name": "desktop-cat",
  "productName": "Desktop Cat",
  "version": "1.4.0",
  "description": "A living desktop companion: one animated, persistent cat that lives on your Windows desktop.",
  "author": "enesiltas",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "build:uia": "node scripts/build-uia-helper.mjs",
    "build:web": "node scripts/build.mjs --web-only",
    "start": "electron .",
    "dev": "node scripts/build.mjs --dev && electron . --dev",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "node scripts/build.mjs && playwright test",
    "test:web": "node scripts/build.mjs --web-only --web-test && playwright test -c playwright.web.config.mts",
    "icons": "electron scripts/gen-icons.cjs",
    "package": "node scripts/build.mjs && electron-builder --win nsis --x64 --publish never",
    "package:win:arm64": "node scripts/stage-koffi-arch.mjs --arch arm64 && node scripts/build.mjs && electron-builder --win nsis --arm64 --publish never",
    "package:win": "node scripts/stage-koffi-arch.mjs --arch arm64 && node scripts/build.mjs && electron-builder --win nsis --x64 --arm64 --publish never",
    "package:dir": "node scripts/build.mjs && electron-builder --win dir --x64 --publish never",
    "package:linux": "node scripts/build.mjs && electron-builder --linux AppImage tar.gz --publish never",
    "package:mac": "node scripts/build.mjs && electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "package:mac:universal": "node scripts/build.mjs && electron-builder --mac dmg zip --universal --publish never",
    "package:mac:adhoc-docker": "node scripts/with-lock.mjs mac-docker -- node scripts/package-mac-docker.mjs",
    "package:web": "node scripts/build.mjs --web-only && node scripts/package-web.mjs",
    "android:web": "node scripts/build-web-app.mjs",
    "android:apk": "node scripts/with-lock.mjs android -- node scripts/android-gradle.mjs :app:assembleRelease",
    "android:aab": "node scripts/with-lock.mjs android -- node scripts/android-gradle.mjs :app:bundleRelease",
    "android:trial": "node scripts/with-lock.mjs android -- node scripts/android-gradle.mjs :app:assembleTrial",
    "release:sums": "node scripts/release-sums.mjs",
    "capability-matrix": "node scripts/capability-matrix.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "verify": "node scripts/with-lock.mjs verify -- npm run check"
  },
  "dependencies": {
    "koffi": "3.3.4"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "electron": "44.9.3",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
